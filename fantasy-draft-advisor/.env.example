# --- ESPN league info (required) ---
# Find these in your ESPN Fantasy Football league URL:
# https://fantasy.espn.com/football/team?leagueId=XXXXXXX&teamId=Y&seasonId=2026
ESPN_LEAGUE_ID=
ESPN_YEAR=2026
ESPN_TEAM_ID=

# --- ESPN private league cookies (leave blank for a public league) ---
# See README.md for how to grab these from your browser.
ESPN_S2=
ESPN_SWID=

# --- Claude (the GM) ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# --- FantasyPros ---
# Path to a rankings CSV you exported from fantasypros.com (see README.md).
# FANTASYPROS_CSV_PATH=data/fantasypros_rankings.csv

# --- Misc ---
# Just used to tell Claude what scoring format your league uses.
# SCORING_LABEL=PPR
